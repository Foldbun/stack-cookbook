{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Foldbun/stack-cookbook/main/contract/result.schema.json",
  "title": "result.json",
  "description": "Output of one run of one implementation, written to <out>/result.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "usecase",
    "language",
    "client",
    "startedAt",
    "elapsedMs",
    "items",
    "ledger"
  ],
  "properties": {
    "usecase": {
      "type": "string"
    },
    "language": {
      "enum": [
        "curl",
        "python",
        "typescript",
        "go"
      ]
    },
    "client": {
      "type": "string",
      "description": "Client file and version, e.g. \"stack_client 1.0.0\"; \"curl\" for curl."
    },
    "startedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calls",
        "listTotal",
        "chargedTotal"
      ],
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of entries in all items[].calls, replayed calls included."
        },
        "listTotal": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of `list` over calls that were not replayed."
        },
        "chargedTotal": {
          "type": "number",
          "minimum": 0,
          "description": "Sum of `charged` over calls that were not replayed."
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "calls",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "expired"
          ]
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/call"
          }
        },
        "output": {
          "type": [
            "object",
            "null"
          ],
          "description": "Use-case output, validated by use-cases/<id>/output.schema.json when present; null unless status is ok."
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "integer",
              "description": "HTTP status; 0 for a local error."
            },
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "model",
        "list",
        "charged",
        "cache",
        "queueMs",
        "processingMs",
        "replayed"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^/v1/"
        },
        "model": {
          "type": "string"
        },
        "list": {
          "type": "number",
          "minimum": 0,
          "description": "billing.total: list price of the call (encoding fee 0 on a cache hit)."
        },
        "charged": {
          "type": "number",
          "minimum": 0,
          "description": "cost: what the balance was debited; 0 for replayed calls."
        },
        "cache": {
          "enum": [
            "hit",
            "miss",
            null
          ],
          "description": "SAM models only; null otherwise."
        },
        "queueMs": {
          "type": "integer",
          "minimum": 0
        },
        "processingMs": {
          "type": "integer",
          "minimum": 0
        },
        "replayed": {
          "type": "boolean",
          "description": "Idempotent-Replayed header (single calls) or item.replayed (batch)."
        }
      }
    }
  }
}
