# HELP stack_credits_total Credits of every priced line; charged=true was debited, false was covered by a daily allowance.
# TYPE stack_credits_total counter
stack_credits_total{charged="false",model="ppocr-v6",unit="image"} 1.5
stack_credits_total{charged="false",model="sam-lite",unit="encode_image"} 0.2
stack_credits_total{charged="false",model="sam-lite",unit="box"} 0.09999999999999999
stack_credits_total{charged="true",model="sam3",unit="encode_image"} 0.5
stack_credits_total{charged="true",model="sam3",unit="prompt"} 0.25
# HELP stack_calls_total Calls by outcome: ok, replayed, error, expired or refused (never sent); code is the API error code.
# TYPE stack_calls_total counter
stack_calls_total{code="none",model="ppocr-v6",status="ok"} 6.0
stack_calls_total{code="none",model="sam-lite",status="ok"} 10.0
stack_calls_total{code="none",model="sam3",status="ok"} 5.0
# HELP stack_cache_hits_total SAM calls whose image encoding was already cached (encode_image fee waived).
# TYPE stack_cache_hits_total counter
stack_cache_hits_total{model="sam-lite"} 9.0
stack_cache_hits_total{model="sam3"} 4.0
# HELP stack_cache_misses_total SAM calls that paid for encoding the image.
# TYPE stack_cache_misses_total counter
stack_cache_misses_total{model="sam-lite"} 1.0
stack_cache_misses_total{model="sam3"} 1.0
# HELP stack_cache_saved_credits_total List price of the encoding fees waived by cache hits.
# TYPE stack_cache_saved_credits_total counter
stack_cache_saved_credits_total{model="sam-lite"} 1.7999999999999998
stack_cache_saved_credits_total{model="sam3"} 2.0
