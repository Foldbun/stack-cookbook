{
  "__inputs": [{ "name": "DS_PROMETHEUS", "label": "Prometheus", "type": "datasource", "pluginId": "prometheus", "pluginName": "Prometheus" }],
  "title": "Foldbun Stack: cost and latency",
  "uid": "foldbun-stack-cost-latency",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "tags": ["foldbun", "stack"],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Credits per hour by model and unit (list price)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (model, unit) (increase(stack_credits_total[1h]))", "legendFormat": "{{model}} {{unit}}" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Debited per hour (charged=true) against the guard's limit", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(increase(stack_credits_total{charged=\"true\"}[1h]))", "legendFormat": "debited, last hour" },
        { "refId": "B", "expr": "stack_spend_window_credits", "legendFormat": "guard window (in process)" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Encoding cache hit rate (1 h)", "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(increase(stack_cache_hits_total[1h])) / clamp_min(sum(increase(stack_cache_hits_total[1h])) + sum(increase(stack_cache_misses_total[1h])), 1)" }]
    },
    {
      "id": 4, "type": "stat", "title": "Credits saved by cache hits (1 h)", "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum(increase(stack_cache_saved_credits_total[1h]))" }]
    },
    {
      "id": 5, "type": "stat", "title": "Balance (credits)", "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "stack_balance_credits" }]
    },
    {
      "id": 6, "type": "stat", "title": "Balance age (seconds)", "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "time() - stack_balance_updated_timestamp_seconds" }]
    },
    {
      "id": 7, "type": "timeseries", "title": "Queue time p50 / p95 by model (server-side, ms)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le, model) (rate(stack_latency_ms_bucket{phase=\"queue\"}[10m])))", "legendFormat": "{{model}} p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(stack_latency_ms_bucket{phase=\"queue\"}[10m])))", "legendFormat": "{{model}} p95" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "Processing time p50 / p95 by model (server-side, ms)", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.5, sum by (le, model) (rate(stack_latency_ms_bucket{phase=\"processing\"}[10m])))", "legendFormat": "{{model}} p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, model) (rate(stack_latency_ms_bucket{phase=\"processing\"}[10m])))", "legendFormat": "{{model}} p95" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Calls per minute by outcome", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (model, status, code) (rate(stack_calls_total[5m])) * 60", "legendFormat": "{{model}} {{status}} {{code}}" }]
    },
    {
      "id": 10, "type": "timeseries", "title": "Included daily calls used / limit", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "datasource": "${DS_PROMETHEUS}", "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "stack_daily_allowance_used", "legendFormat": "{{pool}} used" },
        { "refId": "B", "expr": "stack_daily_allowance_limit", "legendFormat": "{{pool}} limit" }
      ]
    }
  ]
}
