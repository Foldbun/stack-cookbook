---
// The Foldbun Stack mark (Design System 0.4, Noto 2D, wheat), one <img> per theme; the theme CSS shows the one that matches. Decorative: the brand link carries the label.
import light from '../assets/brand/foldbun-stack-color-wheat-light.svg'
import dark from '../assets/brand/foldbun-stack-color-wheat-dark.svg'
---

<img class="logo logo-light" src={light.src} alt="" width="22" height="22" />
<img class="logo logo-dark" src={dark.src} alt="" width="22" height="22" />
